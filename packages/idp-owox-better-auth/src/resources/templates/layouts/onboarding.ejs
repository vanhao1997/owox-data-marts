<!DOCTYPE html>
<html lang="vi">
<%- include('../partials/head', { pageTitle, gtmContainerId }) %>

<body class="min-h-screen bg-background">

  <% if (gtmContainerId) { %>
  <!-- Google Tag Manager (noscript) -->
  <noscript>
    <iframe
      src="https://www.googletagmanager.com/ns.html?id=<%= gtmContainerId %>"
      height="0"
      width="0"
      style="display:none;visibility:hidden">
    </iframe>
  </noscript>
  <% } %>

  <main class="min-h-screen flex flex-col">

    <!-- Logo -->
    <div class="flex gap-2 items-center p-4 lg:p-8">
      <img
        src="https://digitalreport.p2pdigital.io.vn/logo-mark.png"
        width="30"
        height="24"
        alt="P2PDigital Data Marts"
      />
      <div class="text-base font-bold text-foreground tracking-tight">
        P2PDigital Data Marts
      </div>
    </div>

    <!-- Content (centered, no brand panel) -->
    <div class="flex-1 flex w-full h-full items-center justify-center p-4 lg:p-8">
        <%- body %>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer') %>

  </main>

</body>
</html>
