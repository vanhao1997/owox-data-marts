---
import Default from '@astrojs/starlight/components/PageSidebar.astro';
---

<button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Ẩn hoặc hiện thanh điều hướng" title="Ẩn hoặc hiện thanh điều hướng">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
      <path d="M8 5l5 5-5 5V5z"/>
    </svg>
  </button>

<div id="page-sidebar" class="custom-page-sidebar">
  <Default {...Astro.props} />
</div>

<style is:global>

  .sidebar-toggle-btn {
    position: fixed;
    right: 0;
    top: calc(var(--sl-nav-height) + 2 * var(--sl-nav-pad-y));
    transform: translateY(-50%);
    z-index: 100;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-right: none;
    border-radius: 0.5rem 0 0 0.5rem;
    padding: 0.5rem 0.5rem;
    cursor: pointer;
    color: var(--sl-color-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sidebar-toggle-btn:hover {
    background: var(--sl-color-bg-sidebar);
    border-color: var(--sl-color-text-accent);
  }

  .sidebar-toggle-btn svg {
    transition: transform 0.3s ease;
    transform-origin: center;
  }

  .sidebar-toggle-btn.collapsed svg {
    transform: rotate(180deg);
  }

  .custom-page-sidebar.collapsed {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  .right-sidebar-container.collapsed {
    width: 0 !important;
    overflow: visible !important;
  }

  .right-sidebar-container.collapsed .right-sidebar > * {
    visibility: hidden;
  }

  .right-sidebar-container.collapsed #sidebar-toggle {
    visibility: visible !important;
  }

  .main-pane.sidebar-collapsed {
    --sl-sidebar-width: 0rem !important;
    width: 100% !important;
  }

  .main-pane.sidebar-collapsed .sl-container {
    margin-left: auto;
    margin-right: auto;
  }

  /* Hide toggle on mobile */
  @media (max-width: 72rem) {
    .sidebar-toggle-btn {
      display: none;
    }
  }
</style>

<style is:inline>
  /* Critical styles to prevent FOUC - must be inline */
  html.sidebar-initially-collapsed .right-sidebar-container {
    width: 0 !important;
    overflow: visible !important;
  }

  html.sidebar-initially-collapsed .right-sidebar > * {
    visibility: hidden;
  }

  html.sidebar-initially-collapsed #sidebar-toggle {
    visibility: visible !important;
  }

  html.sidebar-initially-collapsed .custom-page-sidebar {
    opacity: 0;
    transform: translateX(100%);
    pointer-events: none;
  }

  html.sidebar-initially-collapsed .main-pane {
    --sl-sidebar-width: 0rem !important;
    width: 100% !important;
  }

  html.sidebar-initially-collapsed .main-pane .sl-container {
    margin-left: auto;
    margin-right: auto;
  }
</style>

<script is:inline>
  // Apply collapsed state immediately to prevent FOUC
  (function() {
    if (localStorage.getItem('sidebar-collapsed') === 'true') {
      document.documentElement.classList.add('sidebar-initially-collapsed');
    }
  })();
</script>

<script>
  const viSidebarLabels = {
    Intro: 'Giới thiệu',
    'Getting started': 'Bắt đầu',
    'Quick Start 🚀': 'Bắt đầu nhanh 🚀',
    'Core Concepts': 'Khái niệm cốt lõi',
    Editions: 'Các phiên bản',
    'P2PDigital Cloud Editions': 'Phiên bản P2PDigital Cloud',
    'OWOX Cloud Editions': 'Phiên bản P2PDigital Cloud',
    'Self-Managed Editions': 'Phiên bản tự quản lý',
    Agency: 'Đại lý',
    Billing: 'Thanh toán',
    'Consumption Units': 'Đơn vị sử dụng',
    'Deployment Guide': 'Hướng dẫn triển khai',
    'Setup Guide': 'Hướng dẫn thiết lập',
    Insights: 'Thông tin chuyên sâu',
    'Using Data Marts from OWOX Extension': 'Sử dụng Data Mart từ tiện ích Google Sheets',
    'Connector-based Data Mart': 'Data Mart dựa trên connector',
    'SQL-based Data Mart': 'Data Mart dựa trên SQL',
    'Table-based Data Mart': 'Data Mart dựa trên bảng',
    'View-based Data Mart': 'Data Mart dựa trên khung nhìn',
    'Pattern-based Data Mart': 'Data Mart dựa trên mẫu',
    'Joinable Data Marts': 'Các Data Mart có thể kết hợp',
    'Export the Models Canvas': 'Xuất canvas mô hình',
    'Data Quality Checks': 'Kiểm tra chất lượng dữ liệu',
    'Data Last Updated': 'Thời điểm cập nhật dữ liệu',
    'Report Output Controls': 'Điều khiển đầu ra báo cáo',
    'Report Aggregations and Totals': 'Tổng hợp và tổng số báo cáo',
    'Calculated Fields': 'Trường tính toán',
    'Connector Trigger': 'Kích hoạt connector',
    'Report Trigger': 'Kích hoạt báo cáo',
    'MCP Server': 'Máy chủ MCP',
    'Self-Managed Authentication': 'Xác thực tự quản lý',
    'Project Settings': 'Cài đặt dự án',
    'License Keys': 'Khóa giấy phép',
    'Members Management': 'Quản lý thành viên',
    'Managing Project Members': 'Quản lý thành viên dự án',
    'Roles and Permissions': 'Vai trò và quyền',
    'Ownership and Sharing': 'Quyền sở hữu và chia sẻ',
    Contexts: 'Ngữ cảnh',
    Notifications: 'Thông báo',
    'Notification Settings': 'Cài đặt thông báo',
    'Email Notifications': 'Thông báo email',
    Webhooks: 'Webhook',
    Destinations: 'Điểm đến',
    'Supported Destinations': 'Điểm đến được hỗ trợ',
    Storages: 'Kho lưu trữ',
    'Supported Storages': 'Kho lưu trữ được hỗ trợ',
    Sources: 'Nguồn dữ liệu',
    API: 'API',
    Plugins: 'Plugin',
    Contributing: 'Đóng góp',
    Repository: 'Kho mã nguồn',
    Connectors: 'Connector',
    Documentation: 'Tài liệu',
    'CLI Application': 'Ứng dụng CLI',
    'Web Application': 'Ứng dụng web',
    'Backend Application': 'Ứng dụng backend',
    Licenses: 'Giấy phép',
  };

  function localizeVietnameseSidebar() {
    if (document.documentElement.lang !== 'vi') return;
    const sidebar = document.querySelector('#starlight__sidebar, #page-sidebar');
    if (!sidebar) return;

    sidebar.querySelectorAll('a, span, summary, button, [role="group"], [role="heading"]').forEach((element) => {
      const text = element.textContent?.trim();
      const translated = text && viSidebarLabels[text];
      if (translated && element.children.length === 0) element.textContent = translated;
    });

    const localizedRoutes = [
      'quick-start',
      'core-concepts',
      'setup-guide/insights',
      'setup-guide/data-mart',
      'setup-guide/storage',
      'setup-guide/destination',
    ];
    sidebar.querySelectorAll('a[href]').forEach((link) => {
      const href = link.getAttribute('href');
      const route = localizedRoutes.find((candidate) => href?.includes(`/vi/docs/getting-started/${candidate}/`));
      if (route) link.setAttribute('href', `/vi/getting-started/${route}/`);
    });
  }

  function initSidebarToggle() {
    const toggleBtn = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('page-sidebar');
    const container = document.querySelector('.right-sidebar-container');
    const mainPane = document.querySelector('.main-pane');
    
    if (!toggleBtn || !sidebar || !container || !mainPane) return;

    localizeVietnameseSidebar();

    // Remove initial class to allow normal styles to work
    document.documentElement.classList.remove('sidebar-initially-collapsed');

    // Load saved state
    const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
    if (isCollapsed) {
      toggleBtn.classList.add('collapsed');
      sidebar.classList.add('collapsed');
      container.classList.add('collapsed');
      mainPane.classList.add('sidebar-collapsed');
    }

    toggleBtn.addEventListener('click', () => {
      const collapsed = toggleBtn.classList.toggle('collapsed');
      sidebar.classList.toggle('collapsed');
      container.classList.toggle('collapsed');
      mainPane.classList.toggle('sidebar-collapsed');
      
      // Save state
      localStorage.setItem('sidebar-collapsed', String(collapsed));
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initSidebarToggle);
  
  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initSidebarToggle);
  document.addEventListener('DOMContentLoaded', localizeVietnameseSidebar);
  document.addEventListener('astro:page-load', localizeVietnameseSidebar);
</script>
