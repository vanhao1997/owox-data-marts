{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        "dist-cjs/**"
      ],
      "outputLogs": "new-only"
    },
    "build:dep": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "eslint.config.*",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint:fix": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "lint:md": {
      "inputs": [
        "**/*.md",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint:md:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": [
        "src/**",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "tsconfig.json",
        "package.json",
        "jest.config.*",
        "vitest.config.*",
        "vite.config.*"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "coverage/**"
      ],
      "outputLogs": "new-only"
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
